PORT=8000
MONGO_URI=mongodb://localhost:27017/devfusion
JWT_SECRET=your_jwt_secret_here
ADMIN_SESSION_TTL=24h
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
BREVO_USER=your_brevo_user
BREVO_PASS=your_brevo_pass
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
GEOAPIFY_API_KEY=your_geoapify_api_key
FRONTEND_URL=http://localhost:3000

# Proxy Configuration (defaults to false / OFF; set to true or hop count behind a reverse proxy / load balancer)
TRUST_PROXY=false

# Rate Limiting Configuration (in-memory counters per instance, reset on restart)
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW_MS=900000

RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000

RATE_LIMIT_REQUEST_OTP_IP_MAX=10
RATE_LIMIT_REQUEST_OTP_EMAIL_MAX=5
RATE_LIMIT_REQUEST_OTP_WINDOW_MS=900000

RATE_LIMIT_VERIFY_OTP_IP_MAX=20
RATE_LIMIT_VERIFY_OTP_EMAIL_MAX=10
RATE_LIMIT_VERIFY_OTP_WINDOW_MS=900000

RATE_LIMIT_REGISTER_UPLOADS_MAX=5
RATE_LIMIT_REGISTER_UPLOADS_WINDOW_MS=3600000

RATE_LIMIT_ACCOUNT_SENSITIVE_MAX=10
RATE_LIMIT_ACCOUNT_SENSITIVE_WINDOW_MS=900000

RATE_LIMIT_DELIVERY_OTP_GEN_MAX=6
RATE_LIMIT_DELIVERY_OTP_GEN_WINDOW_MS=900000

RATE_LIMIT_DELIVERY_OTP_VERIFY_MAX=10
RATE_LIMIT_DELIVERY_OTP_VERIFY_WINDOW_MS=900000

# File Upload Hardening Limits (bytes / counts)
UPLOAD_DOC_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_DOC_MAX_FILES=4
UPLOAD_DOC_MAX_PARTS=64
UPLOAD_PRODUCT_MAX_FILE_SIZE_BYTES=3145728
UPLOAD_PRODUCT_MAX_FILES=1
UPLOAD_PRODUCT_MAX_PARTS=61
UPLOAD_MAX_FIELDS=60
UPLOAD_MAX_FIELD_SIZE_BYTES=102400
